# ============================================================
# Branded Content Generation - Environment Variables
# ============================================================

# Eleven Labs TTS API
# Get API key from: https://elevenlabs.io/app/api-keys
ELEVEN_LABS_API_KEY=your_eleven_labs_api_key_here

# Banana.dev Image Generation API
# Get API key from: https://app.banana.dev/account/api-keys
BANANA_API_KEY=your_banana_api_key_here
BANANA_ENDPOINT=https://api.banana.dev/start/v4/

# ============================================================
# Character Profiles & Default Voices
# ============================================================

# Gema Character - Eleven Labs Voice ID
# This is the professional woman voice for Gema
GEMA_VOICE_ID=hFyqYpDgcxGhrlIVAeYq

# Default models for generation
FAL_DEFAULT_IMAGE_MODEL=fal-ai/gemini-25-flash-image
FAL_DEFAULT_VIDEO_MODEL=fal-ai/kling-video/v2
STUDIO_AVATAR_PROVIDER=heygen

# ============================================================
# Brand Colors (KAPI Service Group)
# ============================================================

# Navy Blue - Primary
KAPI_PRIMARY=#001F4D
KAPI_PRIMARY_OKLCH=oklch(0.18 0.08 250)

# Lime Green - Secondary
KAPI_SECONDARY=#BFCC00
KAPI_SECONDARY_OKLCH=oklch(0.75 0.24 100)

# Cyan/Turquoise - Accent
KAPI_ACCENT=#00A9B5
KAPI_ACCENT_OKLCH=oklch(0.60 0.18 200)

# ============================================================
# Google Drive References
# ============================================================

# Gema character folder on Google Drive
GEMA_DRIVE_FOLDER_ID=1J7da1eMHWlfalemK-_VdZFFKVf_mlGZm

