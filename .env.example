SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpvdXpucndyaXJzaXNkcWlwY2ZiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjYwMDQ2MTEsImV4cCI6MjA4MTU4MDYxMX0.0zjKGv24UCSm6cR37sFklHyEVScLKg8J0QT_EyL5xws
# Obtener desde Dashboard → Settings → API → Service Role Key (NUNCA commitear)
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://zouznrwrirsisdqipcfb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpvdXpucndyaXJzaXNkcWlwY2ZiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjYwMDQ2MTEsImV4cCI6MjA4MTU4MDYxMX0.0zjKGv24UCSm6cR37sFklHyEVScLKg8J0QT_EyL5xws

# ============== Redis (Upstash) ==============
REDIS_URL=

# ============== Anthropic Claude ==============
# Solo se inyecta en el container apps/ai (kapi-ai en Coolify).
# Nunca en apps/web (Netlify) ni con prefix NEXT_PUBLIC_ — bypasea billing.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# URL interna donde apps/api alcanza al servicio de IA.
# - Local dev:     http://localhost:3002
# - Coolify (red interna):  http://kapi-ai:3002
AI_URL=http://localhost:3002

# ============== Meta (Facebook Pages + IG vinculadas + Threads + WhatsApp) ==============
# Este flow es el "Facebook Login". El usuario inicia sesion con Facebook y
# descubrimos sus Pages + cuentas IG Business vinculadas a esas Pages.
# Requiere que el usuario tenga al menos una Page administrable.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/callback/meta
META_GRAPH_VERSION=v25.0
# Por defecto el flow Facebook Login pide solo scopes de Pages
# (pages_show_list, pages_read_engagement, pages_manage_posts) — los que
# cualquier app tiene sin App Review. Si tu app ya tiene aprobados scopes
# legacy de Instagram via Graph API clásico, sumalos aca (coma-separados).
# Ej: META_EXTRA_SCOPES=instagram_basic,instagram_manage_insights
# Si los pones sin tenerlos aprobados, Meta rechaza el flow entero.
META_EXTRA_SCOPES=
# Debug verbose del flow OAuth de Facebook. Setea "1" temporalmente cuando
# estás diagnosticando por qué un connect termina con 0 Pages. Loguea (con
# tokens enmascarados) el token exchange, /me, /me/accounts crudo, y la
# decisión de filter por Page. Apagar (vacío o "0") después de diagnosticar
# para no inflar los logs.
DEBUG_META_OAUTH=

# ============== Meta Ads (modelo "agencia central") ==============
# Independiente del Login orgánico de arriba. Setup completo en docs/META_ADS_AGENCY.md
#
# 1. Crear/usar tu Meta Business Portfolio (Business Manager) propio.
# 2. Asignarle las Ad Accounts de tus clientes (o crear hijas dentro).
# 3. Crear un System User con permisos "Ads management" sobre esas cuentas.
# 4. Generar un token "Never expire" desde ese System User.
# 5. Pegar el token en META_SYSTEM_USER_TOKEN (server-only, NUNCA con prefix NEXT_PUBLIC_).
#
# Este flow NO requiere App Review — el System User actúa como admin del
# Business Portfolio, no como app third-party en nombre de terceros.
META_SYSTEM_USER_TOKEN=
META_BUSINESS_ID=

# Org operadora (KAPI). Miembros owner/admin de esta org pueden aprobar
# campañas en /api/admin/ads/*. Es el UUID de la organización en kapi_pulse.organizations.
ADMIN_ORG_ID=

# Chat de Telegram donde llegan notificaciones administrativas de Ads:
# - nueva campaña pendiente de aprobación
# - campaña aprobada (creada en Meta como PAUSED)
# - campaña lanzada (ACTIVE, gastando)
# Para obtenerlo: agrega tu bot a un grupo o chat, manda /start, y consulta
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates → result[0].message.chat.id
# Si está vacío, las notificaciones se saltan silenciosamente.
TELEGRAM_ADMIN_CHAT_ID=

# ============== Instagram Login (directo, sin Facebook Page) ==============
# Flow alternativo donde el usuario conecta su cuenta IG Business o Creator
# SIN necesidad de Facebook Page. Endpoints viven en graph.instagram.com.
# Configura "Instagram API" dentro de tu Meta App y usa el "Instagram app ID"
# y "Instagram app secret" que aparecen en el panel de Instagram API.
# Redirect URI a registrar en Meta: <API_URL>/api/callback/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/callback/instagram
INSTAGRAM_GRAPH_VERSION=v22.0
# Scopes opcionales que requieren App Review aprobado (coma-separados).
# Por defecto pedimos solo instagram_business_basic + instagram_business_content_publish.
# Ejemplo cuando tu app tenga aprobados los avanzados:
#   INSTAGRAM_EXTRA_SCOPES=instagram_business_manage_comments,instagram_business_manage_messages
INSTAGRAM_EXTRA_SCOPES=

# WhatsApp Cloud API (configurar despues de Meta Business Verification con RUC)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ============== TikTok ==============
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/api/callback/tiktok

# ============== LinkedIn ==============
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/callback/linkedin

# ============== X (Twitter) ==============
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3001/api/callback/x

# ============== YouTube (Google) ==============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/callback/google

# ============== Pinterest ==============
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3001/api/callback/pinterest

# ============== Telegram ==============
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ============== Pagos ==============
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============== Email ==============
RESEND_API_KEY=
EMAIL_FROM=noreply@kapi-pulse.com

# ============== Observabilidad ==============
SENTRY_DSN=
BETTERSTACK_TOKEN=
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============== Encriptacion ==============
TOKEN_ENCRYPTION_KEY=  # 32 bytes hex; generar con: openssl rand -hex 32

# ============== Studio: Generación visual con IA ==============
# Todas estas claves viven SOLO en apps/api y apps/worker — NUNCA con prefijo
# NEXT_PUBLIC_*. Si el browser pudiera invocar Fal/HeyGen directo, gastaría
# créditos sin pasar por la deducción atómica del backend.

# Fal.ai (Flux para imágenes + Kling/Luma para video)
FAL_KEY=
FAL_API_URL=https://queue.fal.run
# Modelo de imagen por defecto. Opciones via fal:
#   fal-ai/gemini-25-flash-image  -> Nano Banana (Gemini 2.5 Flash Image) de Google
#   fal-ai/flux/dev               -> FLUX dev (anterior default)
FAL_DEFAULT_IMAGE_MODEL=fal-ai/gemini-25-flash-image
FAL_DEFAULT_VIDEO_MODEL=fal-ai/kling-video/v2

# Replicate (fallback de imagen cuando Fal está 429/503)
REPLICATE_API_TOKEN=
STUDIO_IMAGE_FALLBACK=replicate
REPLICATE_SDXL_VERSION=7762fd07cf82c948538e41f63f77d685e02b063e37e496e96eefd46c929f9bdc

# HeyGen (avatares UGC)
HEYGEN_API_KEY=
HEYGEN_API_URL=https://api.heygen.com
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=

# Hedra (avatar alternativo)
HEDRA_API_KEY=
HEDRA_API_URL=https://mercury.dev.dream-ai.com/api/v1
STUDIO_AVATAR_PROVIDER=heygen  # 'heygen' | 'hedra'

# Storage + límites
STUDIO_BUCKET=generated-assets
STUDIO_MAX_IMAGES_PER_REQUEST=4
STUDIO_VIDEO_POLL_INTERVAL_MS=5000
STUDIO_VIDEO_MAX_POLL_MINUTES=8
STUDIO_SIGNED_URL_TTL_SECONDS=3600
